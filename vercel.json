{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "github": {
    "silent": false,
    "autoJobCancelation": false
  }
}
